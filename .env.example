# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NOTIFICATION_EMAILS: Comma-separated recipient emails to receive instant alerts when a form is submitted
NOTIFICATION_EMAILS="jaimzz247@gmail.com, teamlead@getportalbuild.com"

# EMAIL_FROM: Sender address for notifications (once your domain is verified in Resend)
EMAIL_FROM="notifications@getportalbuild.com"

# Email Provider Configuration (Choose one of the following methods):

# Option A: Resend API Key (Simplest & fast delivery)
RESEND_API_KEY=

# Option B: Gmail / Custom SMTP credentials
# GMAIL_USER="your-sender-address@gmail.com"
# GMAIL_APP_PASSWORD="your-16-char-app-password"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER=
# SMTP_PASS=

# Option C: Webhook (Slack / Discord / Zapier / Make)
# NOTIFICATION_WEBHOOK_URL=
