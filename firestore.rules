rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primary Auth Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && (
        request.auth.token.email == "elevatemensah@gmail.com" && 
        request.auth.token.email_verified == true
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isOwner() || 
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }

    function isFullControlAdmin() {
      return isSignedIn() && (
        isOwner() || (
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.role == "full_control"
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.\\@]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Admin document validation helper
    function isValidAdmin(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'invitedBy', 'invitedAt'])
        && data.keys().size() == 5
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.role is string && (data.role == 'read_only' || data.role == 'full_control')
        && data.invitedBy is string && data.invitedBy.size() > 0
        && data.invitedAt is string;
    }

    // Application validation helper - enforces exact schemas and bounds to defend against denial-of-wallet
    function isValidApplication(data) {
      return data.keys().hasAll(['name', 'email', 'businessType', 'revenue', 'bottlenecks', 'features', 'status', 'createdAt', 'updatedAt'])
        && data.keys().size() <= 13
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.email is string && data.email.size() > 0 && data.email.size() <= 300
        && data.businessType is string && data.businessType.size() > 0 && data.businessType.size() <= 100
        && data.revenue is string && data.revenue.size() > 0 && data.revenue.size() <= 100
        && data.bottlenecks is list && data.bottlenecks.size() <= 20
        && data.features is list && data.features.size() <= 20
        && data.status is string && (data.status == 'pending' || data.status == 'reviewed' || data.status == 'approved' || data.status == 'rejected')
        // Optional Fields
        && (!data.keys().contains('phone') || (data.phone is string && data.phone.size() <= 50))
        && (!data.keys().contains('website') || (data.website is string && data.website.size() <= 200))
        && (!data.keys().contains('theme') || (data.theme is string && data.theme.size() <= 100))
        && (!data.keys().contains('notes') || (data.notes is string && data.notes.size() <= 2000));
    }

    // Preview Request validation helper
    function isValidPreviewRequest(data) {
      return data.keys().hasAll(['email', 'programUrl', 'cohortStartDate', 'status', 'createdAt', 'updatedAt'])
        && data.keys().size() <= 9
        && data.email is string && data.email.size() > 0 && data.email.size() <= 300
        && data.programUrl is string && data.programUrl.size() > 0 && data.programUrl.size() <= 500
        && data.cohortStartDate is string && data.cohortStartDate.size() > 0 && data.cohortStartDate.size() <= 100
        && data.status is string && (data.status == 'pending_preview' || data.status == 'reviewed' || data.status == 'contacted' || data.status == 'completed')
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50
        // Optional Fields
        && (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128))
        && (!data.keys().contains('ref') || (data.ref is string && data.ref.size() <= 200))
        && (!data.keys().contains('a') || (data.a is string && data.a.size() <= 200));
    }

    // Site Session validation helper (First-Party Telemetry)
    function isValidSiteSession(data) {
      return data.keys().hasAll(['sessionId', 'visitorId', 'deviceType', 'startedAt'])
        && data.keys().size() <= 20
        && data.sessionId is string && data.sessionId.size() > 0 && data.sessionId.size() <= 128
        && data.visitorId is string && data.visitorId.size() > 0 && data.visitorId.size() <= 128
        && data.deviceType is string && data.deviceType.size() <= 50
        && data.startedAt is string && data.startedAt.size() <= 50
        // Optional Fields
        && (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128))
        && (!data.keys().contains('isReturning') || data.isReturning is bool)
        && (!data.keys().contains('referrer') || (data.referrer is string && data.referrer.size() <= 500))
        && (!data.keys().contains('utmSource') || (data.utmSource is string && data.utmSource.size() <= 150))
        && (!data.keys().contains('utmMedium') || (data.utmMedium is string && data.utmMedium.size() <= 150))
        && (!data.keys().contains('utmCampaign') || (data.utmCampaign is string && data.utmCampaign.size() <= 150))
        && (!data.keys().contains('ref') || (data.ref is string && data.ref.size() <= 150))
        && (!data.keys().contains('a') || (data.a is string && data.a.size() <= 150))
        && (!data.keys().contains('path') || (data.path is string && data.path.size() <= 300))
        && (!data.keys().contains('lastActiveAt') || (data.lastActiveAt is string && data.lastActiveAt.size() <= 50))
        && (!data.keys().contains('pageViews') || data.pageViews is int)
        && (!data.keys().contains('isInternal') || data.isInternal is bool)
        && (!data.keys().contains('clientIp') || (data.clientIp is string && data.clientIp.size() <= 100));
    }

    // Site Event validation helper (First-Party Behavioral Telemetry)
    function isValidSiteEvent(data) {
      return data.keys().hasAll(['sessionId', 'visitorId', 'eventType', 'timestamp'])
        && data.keys().size() <= 16
        && data.sessionId is string && data.sessionId.size() > 0 && data.sessionId.size() <= 128
        && data.visitorId is string && data.visitorId.size() > 0 && data.visitorId.size() <= 128
        && data.eventType is string && data.eventType.size() > 0 && data.eventType.size() <= 100
        && data.timestamp is string && data.timestamp.size() <= 50
        // Optional Fields
        && (!data.keys().contains('id') || (data.id is string && data.id.size() <= 128))
        && (!data.keys().contains('eventCategory') || (data.eventCategory is string && data.eventCategory.size() <= 100))
        && (!data.keys().contains('label') || (data.label is string && data.label.size() <= 300))
        && (!data.keys().contains('path') || (data.path is string && data.path.size() <= 300))
        && (!data.keys().contains('metadata') || (data.metadata is string && data.metadata.size() <= 1000))
        && (!data.keys().contains('isInternal') || data.isInternal is bool)
        && (!data.keys().contains('clientIp') || (data.clientIp is string && data.clientIp.size() <= 100));
    }

    match /preview_requests/{requestId} {
      allow get, list: if isAdmin();
      
      allow create: if isValidId(requestId)
        && isValidPreviewRequest(incoming())
        && incoming().status == 'pending_preview';
        
      allow update: if isFullControlAdmin()
        && isValidPreviewRequest(incoming());

      allow delete: if isFullControlAdmin();
    }

    match /applications/{applicationId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      
      allow create: if isValidId(applicationId) 
        && isValidApplication(incoming())
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
        
      allow update: if isFullControlAdmin()
        && isValidApplication(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isFullControlAdmin();
    }

    match /site_sessions/{sessionId} {
      allow get, list: if isAdmin();
      
      allow create: if isValidId(sessionId)
        && isValidSiteSession(incoming());
        
      allow update: if (isAdmin() || (isValidId(sessionId) && isValidSiteSession(incoming())));

      allow delete: if isFullControlAdmin();
    }

    match /site_events/{eventId} {
      allow get, list: if isAdmin();
      
      allow create: if isValidId(eventId)
        && isValidSiteEvent(incoming());

      allow delete: if isFullControlAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isOwner() && (request.method == 'delete' || isValidAdmin(incoming()));
    }
  }
}
